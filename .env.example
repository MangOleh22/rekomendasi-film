APP_NAME=RekomFilm
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_DISPLAY_TIMEZONE=Asia/Jakarta
APP_URL=http://rekomendasi-film.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---------------------------------------------------------------
# DATABASE: pilih SATU (sqlite | mysql | mariadb | pgsql)
# ---------------------------------------------------------------
DB_CONNECTION=sqlite
# MySQL    -> DB_CONNECTION=mysql   DB_PORT=3306
# MariaDB  -> DB_CONNECTION=mariadb DB_PORT=3306
# PostgreSQL -> DB_CONNECTION=pgsql DB_PORT=5432
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=rekomendasi_film
# DB_USERNAME=root
# DB_PASSWORD=

# ---------------------------------------------------------------
# CACHE / SESSION / QUEUE: database (default, tanpa layanan tambahan)
# atau redis (ubah ketiganya menjadi redis; REDIS_CLIENT=predis tidak butuh ekstensi PHP)
# ---------------------------------------------------------------
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_PREFIX=rekomfilm

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------
# REALTIME (Laravel Reverb). Jalankan: php artisan reverb:start
# Kosongkan VITE_REVERB_APP_KEY untuk mematikan realtime di browser.
# Ganti key/secret di produksi (php artisan reverb:install membuat yang baru).
# Banyak server? set REVERB_SCALING_ENABLED=true (memakai Redis).
# ---------------------------------------------------------------
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

REVERB_APP_ID=rekomfilm
REVERB_APP_KEY=rekomfilm-local-key
REVERB_APP_SECRET=rekomfilm-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ---------------------------------------------------------------
# REALTIME via PUSHER (untuk hosting biasa tanpa proses permanen)
# Buat "Channels app" di pusher.com, isi nilai di bawah, set BROADCAST_CONNECTION=pusher,
# lalu jalankan ulang `npm run build` (VITE_* ikut ke bundel).
# PUSHER_APP_SECRET itu RAHASIA: hanya di server, JANGAN dibuat versi VITE_.
# Jika ada yang kosong, siaran otomatis dimatikan (aplikasi tetap jalan).
# ---------------------------------------------------------------
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

MAIL_MAILER=log
